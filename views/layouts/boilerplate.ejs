<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
            integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
        />
        <link rel="stylesheet" href="/css/style.css" />
        <link rel="icon" href="/images/location-arrow-solid.png" />
        <link rel="stylesheet" href="/css/star.css">
        <link href="https://api.mapbox.com/mapbox-gl-js/v3.30.0/mapbox-gl.css" rel="stylesheet">
        <script src="https://api.mapbox.com/mapbox-gl-js/v3.30.0/mapbox-gl.js"></script>
        <script>
            const mapToken = "<%= process.env.MAP_TOKEN %>";
        </script>
        <title>WanderLust</title>
    </head>
    <body>
        <%- include("../includes/nav.ejs")%>
        <div class="container">
        <% if(success && success.length){ %>
            <div
                class="alert alert-success alert-dismissible fade show text-center col-md-6 offset-md-3 mt-3"
                role="alert"
            >
                <%= success %>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>
            </div>
            <% } %>
            
            <% if(error && error.length){ %>
            <div
                class="alert alert-danger alert-dismissible fade show text-center col-md-6 offset-md-3 mt-3"
                role="alert"
            >
                <%= error %>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>
            </div>
            <% } %>

            <% if(err && err.length){ %>
            <div
                class="alert alert-danger alert-dismissible fade show text-center col-md-6 offset-md-3 mt-3"
                role="alert"
            >
                <%= err %>
                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"
                ></button>
            </div>
            <% } %>
            <%- body %>
        </div>
        <%- include("../includes/footer.ejs")%>
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"
        ></script>
        <script src="/js/script.js"></script>

        <script src="/js/mapbox.js"></script>
    </body>
</html>
