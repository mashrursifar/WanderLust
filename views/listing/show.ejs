<% layout('/layouts/boilerplate') %>

<body>
    
    <div class="row show-container ">
        <br>
        <div class="col-md-8">
            <h1> <%= listing.title %> </h1>
        </div>
        <div class="card col-md-8 card-listings">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="img-defult">
        
            <div class="card-body">
                <p> Owned by <b>@<%= username %></b></p>
                <h6>&nbsp;&nbsp;&nbsp;<%= listing.description %></h6> 
                <h6>Price: BDT <%= (listing.price??0).toLocaleString("en-bd") %> </h6>
                <p>Location: <%= listing.location %> <br>
                country: <%= listing.country %></p>
            </div>    
        </div>
    </div>
    
    <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
    <div class="show-btns">
        <div>

            <a href="/listing/<%= listing._id %>/edit"><button class="btn btn-dark show-btn">Edit</button></a>
             
        </div>
        <div>
            <form action="/listing/<%= listing._id %>?_method=Delete" method="post">
                <button class="btn btn-dark show-btn ">Delete</button>
            </form>

        </div>
    </div>
    <% } %>

    <br>
    <hr>

    <!-- Review Form -->
<div class="col-sm-8 mx-auto review">

    <form action="/listing/<%= listing._id %>/reviews"
          method="post"
          novalidate
          class="needs-validation">

        <h4>Leave a review</h4>

         <fieldset class="rating-input rating-black" aria-label="Choose a rating">
          <input id="rating-5" type="radio" name="rating" value="5" required>
          <label for="rating-5" title="5 stars">★</label>
          <input id="rating-4" type="radio" name="rating" value="4">
          <label for="rating-4" title="4 stars">★</label>
          <input id="rating-3" type="radio" name="rating" value="3">
          <label for="rating-3" title="3 stars">★</label>
          <input id="rating-2" type="radio" name="rating" value="2">
          <label for="rating-2" title="2 stars">★</label>
          <input id="rating-1" type="radio" name="rating" value="1">
          <label for="rating-1" title="1 star">★</label>
        </fieldset>

        <textarea
            required
            class="form-control mb-1"
            name="comment"
            rows="3"
            placeholder="Write your opinion"></textarea>

        <div class="invalid-feedback">
            Please add some comments to review.
        </div>

        <button class="btn btn-outline-dark mb-2 mt-2" type="submit">
            Add
        </button>

    </form>

</div>


<!-- Reviews -->
<div class="col-md-8 mx-auto review-listings">

    <div class="row g-2">

        <% for(let list of listing.review){ %>

            <div class="col-sm-6">
                <form 
                action="/listing/<%= listing._id %>/reviews/<%= list._id %>?_method=Delete"
                     method="post">

                <div class="card h-100">
                    <div class="card-body">

                        <p class="card-text">
                           <b>@<%= list.author.username %></b> <br>
                        
                            <span class="rating-stars rating-black rating-<%= list.rating %>" role="img"></span><br>
                            <%= list.comment %>
                        </p>

                        <!-- <p class="card-text">
                            Rating: <%= list.rating %> star
                        </p> -->
                        <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
                        <button class="btn btn-outline-dark">Delete</button>
                        <% } %>
                    </div>
                </div>
               </form>

            </div>

        <% } %>

    </div>

</div>

<div class="col-md-8 mx-auto mb-3 mt-2">
    <div id="map"></div>
</div>

<script>
    const listing = <%- JSON.stringify(listing) %>;
</script>
</body>
