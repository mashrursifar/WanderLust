<% layout('/layouts/boilerplate') %>
<body>
    
    <form action="/listing/<%= listing._id %>?_method=PUT" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="row">
            <div>
                <label for="title" class="form-label"> Title: </label>
                <input required type="text" value="<%= listing.title %>" placeholder="Enter title" class="newPostCreate form-control" name="title" id="title">
            </div>
        
            <div>
                <label for="description" class="form-label"> Description: </label>
                <textarea required name="description"  class="form-control" id="description" placeholder="Give a description"><%= listing.description %></textarea>
            </div>
            <div class="mb-3">
                Current Image: <br>
                <img src="<%= listing.image.url %>" alt="Listing Image Preview" style="height: 200px; width: 350px;">
            </div>
            <div class="col-md-7">
                
                <label for="image"> Upload Image: </label>
                <input
                    type="file"
                    class="newPostCreate form-control"
                    name="image.url"
                    id="image"
                    accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                    
                />
                <small>Allowed: JPG, JPEG, PNG. Maximum size: 10 MB.</small>
            </div>
            
            <div class="col-md-5">
                <label for="price"> Price: </label>
                <input required type="number" value="<%= listing.price %>" placeholder="Enter the price per day" class="newPostCreate form-control" name="price" id="price" >
        
            </div>

            <!-- Dropdown Tags -->
            <%- include("../includes/tagsEdit.ejs")%>
         
            <div class="col-md-6">
                <label for="location" class="form-label"> Location: </label>
                <input required type="text" value="<%= listing.location %>" placeholder="Enter the location" class="newPostCreate form-control" name="location" id="location">
            </div>

            <div class="col-md-6">
                <label for="country" class="form-label"> Country: </label>
                <input required type="text" value="<%= listing.country %>" placeholder="Enter the country" class="newPostCreate form-control" name="country" id="country">
            </div>

        </div>
            
        <br>
        <button class="btn btn-dark">Submit</button>
    <!-- </form> -->
    <!-- <script src="/public/js/script.js"></script> -->
</body>
